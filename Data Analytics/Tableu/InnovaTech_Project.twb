    <worksheet name='Resolution Rate%'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold' fontsize='12'>Resolution Rate %</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Data+ (Innovatech_Data)' name='federated.1tnwv8p0c7v69q135pkxq1bq8m17' />
          </datasources>
          <datasource-dependencies datasource='federated.1tnwv8p0c7v69q135pkxq1bq8m17'>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_1575978458237022229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Issue_Resolved] = &apos;Yes&apos; THEN &#13;&#10;    1 &#13;&#10;    ELSE &#13;&#10;    0 &#13;&#10;    END) / COUNT([Issue_Resolved])' />
            </column>
            <column caption='Customer Value' datatype='string' name='[Customer_Value]' role='dimension' type='nominal' />
            <column caption='Feedback Category' datatype='string' name='[Feedback_Category]' role='dimension' type='nominal' />
            <column caption='Interaction Date' datatype='date' name='[Interaction_Date]' role='dimension' type='ordinal' />
            <column caption='Issue Resolved' datatype='string' name='[Issue_Resolved]' role='dimension' type='nominal' />
            <column-instance column='[Customer_Value]' derivation='None' name='[none:Customer_Value:nk]' pivot='key' type='nominal' />
            <column-instance column='[Feedback_Category]' derivation='None' name='[none:Feedback_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1575978458237022229]' derivation='User' name='[usr:Calculation_1575978458237022229:qk]' pivot='key' type='quantitative' />
