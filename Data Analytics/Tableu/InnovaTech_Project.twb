      <aliases enabled='yes' />
      <column aggregation='Percentile' aggregation-param='10' caption='Budget Variance' datatype='integer' name='[Budget_Variance]' role='measure' type='quantitative' />
      <column caption='Avg. Efficiency%' datatype='real' name='[Calculation_1017532104675377152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Efficiency (%)])' />
      </column>
      <column caption='Avg. Task Duration (days)' datatype='integer' name='[Calculation_1017532104675815425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Start_Date],[End_Date])' />
      </column>
      <column caption='Completion Rate' datatype='real' name='[Calculation_1017532104677126146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Status] = &apos;Completed&apos; THEN &#13;&#10;    1 &#13;&#10;    ELSE &#13;&#10;    0 &#13;&#10;    END) / COUNT([Status])' />
      </column>
      <column caption='Avg. Cost' datatype='real' name='[Calculation_1017532104678301699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Cost (Operations Data)])' />
      </column>
      <column caption='Forecasted Growth %' datatype='real' name='[Calculation_1017532104752508932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total_Sales]) - LOOKUP(SUM([Total_Sales]),-1)) / LOOKUP(SUM([Total_Sales]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Projected Revenue' datatype='integer' name='[Calculation_1017532104753688581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Projected Profit Margin' datatype='real' name='[Calculation_1017532104754106374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Revenue])' />
      </column>
      <column caption='Total_Sales' datatype='integer' name='[Calculation_1575978458098675712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Sales])' />
      </column>
      <column caption='Total_Profit' datatype='real' name='[Calculation_1575978458100064258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])' />
      </column>
      <column caption='Avg_Profit Margin' datatype='real' name='[Calculation_1575978458100498435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Total_Sales])' />
      </column>
      <column caption='YoY Sales Growth' datatype='real' default-format='p0.00%' name='[Calculation_1575978458100973572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total_Sales]) - &#13;&#10;LOOKUP(SUM([Total_Sales]),-1)) /&#13;&#10;LOOKUP(SUM([Total_Sales]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Year Calculate Date' datatype='integer' name='[Calculation_1575978458105171973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Date])' />
      </column>
      <column caption='CY Sales' datatype='integer' name='[Calculation_1575978458106257414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Date])=[Parameters].[Parameter 1] THEN [Total_Sales]&#13;&#10;END' />
      </column>
      <column caption='PY Sales' datatype='integer' name='[Calculation_1575978458106826759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Date])=[Parameters].[Parameter 1]-1 THEN [Total_Sales]&#13;&#10;END' />
      </column>
      <column caption='% Diff Sales' datatype='real' default-format='p0.0%' name='[Calculation_1575978458107568136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1575978458106257414])-SUM([Calculation_1575978458106826759]))/SUM([Calculation_1575978458106826759])' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_1575978458198220809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue])' />
      </column>
      <column caption='Total Expense' datatype='integer' name='[Calculation_1575978458198384650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Expense])' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0%' name='[Calculation_1575978458198568971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (Finance Data)]) / SUM([Revenue])' />
      </column>
      <column caption='Cost Efficiency' datatype='real' name='[Calculation_1575978458201325581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (Finance Data)])/SUM([Expense])' />
      </column>
      <column caption='Budget Var%' datatype='real' default-format='*▲ 10.00%; ▼ -5.00%;' name='[Calculation_1575978458219610126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - SUM([Budget]))/ SUM([Budget])' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1575978458233540623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID (Customer Master)])' />
      </column>
      <column caption='Avg. Satisfication Score' datatype='real' name='[Calculation_1575978458233978896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Satisfaction_Score])' />
      </column>
      <column caption='Avg. Response time' datatype='real' name='[Calculation_1575978458234282001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Response_Time (hrs)])' />
      </column>
      <column caption='Resolution Rate' datatype='real' name='[Calculation_1575978458237022229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Issue_Resolved] = &apos;Yes&apos; THEN &#13;&#10;    1 &#13;&#10;    ELSE &#13;&#10;    0 &#13;&#10;    END) / COUNT([Issue_Resolved])' />
      </column>
